# Copy to .env and adjust as needed. All values have sensible defaults.

POSTGRES_USER=applify
POSTGRES_PASSWORD=applify
POSTGRES_DB=applify

# Ollama runs natively on Windows (D3); reachable from the container via host.docker.internal.
APPLIFY_OLLAMA_URL=http://host.docker.internal:11434
APPLIFY_OLLAMA_MODEL=qwen3:14b
