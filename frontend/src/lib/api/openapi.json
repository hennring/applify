				"summary": "List Matches",
				"description": "Ranked list (F11); hidden jobs only with excluded=true, each with its reason.",
				"operationId": "list_matches_api_matches_get",
				"parameters": [
					{
						"name": "only_new",
						"in": "query",
						"required": false,
						"schema": {
							"type": "boolean",
							"default": false,
