	"components": {
		"schemas": {
			"ApplyCvChanges": {
				"properties": {
					"document_id": {
						"type": "integer",
						"title": "Document Id"
					},
					"change_ids": {
						"items": {
							"type": "string"
						},
						"type": "array",
						"title": "Change Ids"
					}
				},
				"type": "object",
				"required": ["document_id", "change_ids"],
				"title": "ApplyCvChanges"
			},
			"Body_upload_document_api_documents_post": {
				"properties": {
					"type": {
						"type": "string",
						"enum": ["cv", "certificate", "sample_letter"],
						"title": "Type"
					},
					"file": {
						"type": "string",
						"contentMediaType": "application/octet-stream",
						"title": "File"
					}
				},
				"type": "object",
				"required": ["type", "file"],
				"title": "Body_upload_document_api_documents_post"
			},
			"Breakdown": {
				"properties": {
					"low_data": {
						"type": "boolean",
						"title": "Low Data",
						"default": false
					},
					"components": {
						"items": {
							"$ref": "#/components/schemas/ComponentOut"
						},
						"type": "array",
						"title": "Components",
						"default": []
					}
				},
				"type": "object",
				"title": "Breakdown"
			},
			"ChangeItem": {
				"properties": {
					"id": {
						"type": "string",
						"title": "Id"
					},
					"field": {
						"type": "string",
						"enum": [
							"contact",
							"roles",
							"skills",
							"languages",
							"experience",
							"education",
							"seniority_years"
						],
						"title": "Field"
					},
					"kind": {
						"type": "string",
						"enum": ["add", "change"],
						"title": "Kind"
					},
					"key": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "null"
							}
						],
						"title": "Key"
					},
					"current": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "null"
							}
						],
						"title": "Current"
					},
					"suggested": {
						"type": "string",
						"title": "Suggested"
					}
				},
				"type": "object",
				"required": ["id", "field", "kind", "key", "current", "suggested"],
				"title": "ChangeItem"
			},
			"ComponentHealth": {
				"properties": {
					"status": {
						"type": "string",
						"enum": ["ok", "error"],
						"title": "Status"
					},
					"detail": {
						"anyOf": [
							{
								"type": "string"
							},
							{
								"type": "null"
							}
						],
						"title": "Detail"
					}
				},
				"type": "object",
				"required": ["status"],
				"title": "ComponentHealth"
			},
			"ComponentOut": {
