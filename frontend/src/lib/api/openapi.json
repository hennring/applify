					{
						"name": "sort",
						"in": "query",
						"required": false,
						"schema": {
							"enum": ["score", "date"],
							"type": "string",
							"default": "score",
							"title": "Sort"
						}
					},
					{
						"name": "limit",
						"in": "query",
						"required": false,
						"schema": {
							"type": "integer",
							"maximum": 200,
							"minimum": 1,
							"default": 50,
							"title": "Limit"
						}
					},
